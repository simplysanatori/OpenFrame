	<strings name="main_menu/settings_select/player_setup/player_profile_edit/vr_player/help_strings">
		<string text=""/>
		<string text="Left-handed? LEFT: the weapon in your left hand,\nall mirrored, the sticks swapped (SWAP STICKS)."/>
		<string text="Move with the right stick and turn with the left:\nby default, with the left hand dominant."/>
		<string text="Seated: your eyes where they are when you\nrecentre. From the next time the game starts."/>
		<string text="Standing, the height of your eyes above the\nfloor."/>
		<string text="Crouch in the room and you crouch in the game;\nstand up and you stand."/>
		<string text="How large the world looks: more than 1 makes it\nlarger, and you smaller in it."/>
		<string text="Recentres by itself after a load or a cinematic, and\nas a menu opens. OFF: hold both grips to recentre."/>
		<string text="While a scene holds you still (the cryo tube), how\nfar your head may move the view from the player's eye."/>
		<string text="As you die, the view stays where your head was\n(turned to your body in a blink), or the game's."/>
	</strings>
