	<strings name="main_menu/settings_select/player_setup/player_profile_edit/vr_hud/help_strings">
		<string text=""/>
		<string text="The shields, ammunition and tracker on the visor,\non your other wrist (turn it to your face), or hidden."/>
		<string text="On your helmet's visor, curved about your eyes,\nor a flat screen before them."/>
		<string text="How wide the HUD is, in degrees of your view."/>
		<string text="How far in front of your eyes the HUD is."/>
		<string text="How far apart in depth the HUD's parts are: the\ntracker nearest, the waypoints farthest."/>
		<string text="The HUD's corners turned out along the visor's\ncurve, toward the edges of your view."/>
		<string text="How far the HUD trails your head's turns."/>
		<string text="The visor's glass and glow, the helmet's rim, the\nshields' energy on the glass."/>
		<string text="The HUD on your other wrist: its size, and where\nit sits on the arm."/>
		<string text="Move, bring in or resize the visor HUD's corners:\nammo, shields, tracker (corners cut off?)."/>
