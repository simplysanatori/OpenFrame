<?xml version="1.0" encoding="UTF-8"?>
<!-- The behaviour of ce/main_menu.settings_select.player_setup.player_profile_edit.vr_wrist.xml's widgets, for the menu engine (docs/menu_engine.md; tools/menu_behaviour.py) -->
<model>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_wrist/vr_wrist_screen" flags="pass_unhandled_to_focused_child pause_game">
		<on event="b" back="true"/>
		<on event="back" back="true"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_wrist/options_menu" flags="pass_unhandled_to_focused_child up_down_tabs_children"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_wrist/button_bar" flags="pass_unhandled_to_focused_child left_right_tabs_items"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_wrist/op_wrist_hud_scale" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_wrist/wrist_hud_scale_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="created" run="port setting load"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_wrist/op_wrist_hud_offset_along" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_wrist/wrist_hud_offset_along_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="created" run="port setting load"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_wrist/op_wrist_hud_offset_across" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_wrist/wrist_hud_offset_across_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="created" run="port setting load"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_wrist/op_wrist_hud_offset_out" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_wrist/wrist_hud_offset_out_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="created" run="port setting load"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_wrist/button_defaults">
		<on event="a" run="port settings defaults"/>
		<on event="start" run="port settings defaults"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_wrist/button_ok">
		<on event="a" run="port settings save" back="true"/>
		<on event="start" run="port settings save" back="true"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
</model>
