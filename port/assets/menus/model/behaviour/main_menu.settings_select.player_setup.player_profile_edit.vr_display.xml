	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_display/op_menu_distance" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_display/menu_distance_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="created" run="port setting load"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_display/op_menu_width" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_display/menu_width_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="created" run="port setting load"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_display/button_defaults">
		<on event="a" run="port settings defaults"/>
		<on event="start" run="port settings defaults"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_display/button_ok">
		<on event="a" run="port settings save" back="true"/>
		<on event="start" run="port settings save" back="true"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
</model>
