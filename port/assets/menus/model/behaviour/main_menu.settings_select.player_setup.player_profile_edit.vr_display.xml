<?xml version="1.0" encoding="UTF-8"?>
<!-- The behaviour of ce/main_menu.settings_select.player_setup.player_profile_edit.vr_display.xml's widgets, for the menu engine (docs/menu_engine.md; tools/menu_behaviour.py) -->
<model>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_display/vr_display_screen" flags="pass_unhandled_to_focused_child pause_game">
		<on event="b" back="true"/>
		<on event="back" back="true"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_display/options_menu" flags="pass_unhandled_to_focused_child up_down_tabs_children"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_display/button_bar" flags="pass_unhandled_to_focused_child left_right_tabs_items"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_display/op_refresh_rate" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_display/refresh_rate_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="created" run="port setting load"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_display/op_resolution_scale" flags="pass_unhandled_to_focused_child"/>
