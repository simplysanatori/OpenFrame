		<on event="created" run="port setting load"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_display/op_foveation" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_display/foveation_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="created" run="port setting load"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_display/op_foveation_inset" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_display/foveation_inset_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="created" run="port setting load"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_display/op_late_latch" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_display/late_latch_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
