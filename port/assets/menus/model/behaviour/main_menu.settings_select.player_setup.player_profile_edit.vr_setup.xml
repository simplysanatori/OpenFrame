	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_setup/op_vr_comfort_screen" flags="pass_unhandled_to_focused_child">
		<on event="a" run="port settings save" open="main_menu/settings_select/player_setup/player_profile_edit/vr_comfort/vr_comfort_screen"/>
		<on event="start" run="port settings save" open="main_menu/settings_select/player_setup/player_profile_edit/vr_comfort/vr_comfort_screen"/>
