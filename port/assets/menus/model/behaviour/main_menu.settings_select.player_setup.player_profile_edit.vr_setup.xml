		<on event="a" run="port settings defaults"/>
		<on event="start" run="port settings defaults"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_setup/button_ok">
		<on event="a" run="port settings save" back="true"/>
		<on event="start" run="port settings save" back="true"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/vr_setup_profile_item">
		<on event="a" open="main_menu/settings_select/player_setup/player_profile_edit/vr_setup/vr_setup_screen"/>
